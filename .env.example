# Energy App — environment template (committed). Copy to .env and fill real values.
# In production these live in /opt/energy/.env on the VPS (loaded by systemd).

# --- App / API ---
NODE_ENV=development
API_PORT=3002
API_HOST=127.0.0.1

# --- Tesla Fleet API (cloud) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=
TESLA_ENERGY_SITE_ID=
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_REDIRECT_URI=https://energy.hirobo.nl/api/auth/tesla/callback
TESLA_SCOPES=openid offline_access energy_device_data energy_cmds

# --- Sonnen (local API, reachable from the VPS over the WireGuard tunnel) ---
SONNEN_HOST=192.168.1.197
SONNEN_API_TOKEN=

# --- Notifications ---
# Email via Resend (same provider as the Hirobo app; verified sender domain hirobo.nl).
RESEND_API_KEY=
EMAIL_FROM=Power <noreply@hirobo.nl>
# WhatsApp delivery (optional): Meta Cloud API (token + phone id) OR CallMeBot key.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
CALLMEBOT_KEY=

# --- Database (added later) ---
DATABASE_URL=
